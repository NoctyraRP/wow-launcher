<Window x:Class="WowLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WoW Launcher" Height="600" Width="940"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" Foreground="{StaticResource Text}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Padding="22,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1B2130" Offset="0"/>
                    <GradientStop Color="#12161E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ServerNameText" Text="WoW Server" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource AccentHi}"/>
                    <TextBlock Text="World of Warcraft 3.3.5a" FontSize="12" Foreground="{StaticResource TextDim}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Checking..." Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1" Margin="22,18,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- News -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8"
                    BorderBrush="{StaticResource PanelEdge}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="NEWS" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" Margin="16,14,16,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6,0,6,8">
                        <ItemsControl x:Name="NewsList" Margin="10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,6" Padding="12,10" Background="#141A22" CornerRadius="6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Date}" Foreground="{StaticResource TextDim}"
                                                           FontSize="11" DockPanel.Dock="Right"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentHi}"
                                                           FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Body}" Foreground="{StaticResource Text}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Side panel -->
            <StackPanel Grid.Column="2">
                <Border Background="{StaticResource Panel}" CornerRadius="8"
                        BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="Create an account to play, then log in with it in-game."
                                   Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <Button x:Name="RegisterButton" Style="{StaticResource FlatButton}" Content="Register Account"
                                Click="RegisterButton_Click" Margin="0,0,0,8"/>
                        <Button x:Name="WebsiteButton" Style="{StaticResource FlatButton}" Content="Website"
                                Click="WebsiteButton_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Panel}" CornerRadius="8" Margin="0,14,0,0"
                        BorderBrush="{StaticResource PanelEdge}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="REALMLIST" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                        <TextBlock x:Name="RealmlistText" Text="set realmlist 127.0.0.1"
                                   Foreground="{StaticResource Text}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="Set automatically when you press Play."
                                   Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="2" Background="#12161E" Padding="22,16" BorderBrush="{StaticResource PanelEdge}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="ProgressText" Text="Ready." Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100" Value="0"
                                 Background="#0C0F14" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                </StackPanel>
                <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource PlayButton}" Height="56"
                        Content="PLAY" Click="PlayButton_Click" IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
